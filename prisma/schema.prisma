generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  birthDate          DateTime?           @db.Date
  timezone           String?
  birthDateLocked    Boolean             @default(false)
  sealBalance        Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  letters            Letter[]
  emailChangeRequest EmailChangeRequest?
  sealPurchases      SealPurchase[]
}

/// Pending change of User.email. Old email stays primary until the new
/// address is verified via the one-time link sent to it.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  newEmail  String
  /// SHA-256 hex of the raw token from the verification URL
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Ledger row for a purchased (or locally granted) seal pack.
model SealPurchase {
  id              String    @id @default(cuid())
  userId          String
  packId          String
  seals           Int
  amountCents     Int
  stripeSessionId String?   @unique
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionSet {
  id        String         @id @default(cuid())
  version   Int            @unique
  keys      String[]
  createdAt DateTime       @default(now())
  letters   Letter[]
  answers   CensusAnswer[]
}

model Letter {
  id                String         @id @default(cuid())
  userId            String
  targetAge         Int
  status            LetterStatus   @default(DRAFT)
  body              String         @default("")
  sealedAt          DateTime?
  openedAt          DateTime?
  /// When the birthday unlock “letter waiting” email was sent (idempotency).
  unlockEmailSentAt   DateTime?
  /// When the ~30-day pre-unlock hygiene reminder was sent.
  staleEmailSentAt    DateTime?
  /// When the idle unsealed-draft reminder was sent.
  draftReminderSentAt DateTime?
  questionSetId       String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionSet         QuestionSet    @relation(fields: [questionSetId], references: [id])
  answers             CensusAnswer[]

  @@unique([userId, targetAge])
  @@index([status, unlockEmailSentAt])
  @@index([status, staleEmailSentAt])
  @@index([status, draftReminderSentAt])
}

model CensusAnswer {
  id            String      @id @default(cuid())
  letterId      String
  questionSetId String
  key           String
  value         String      @default("")
  letter        Letter      @relation(fields: [letterId], references: [id], onDelete: Cascade)
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id])

  @@unique([letterId, key])
}

enum LetterStatus {
  DRAFT
  SEALED
  UNLOCKED
  OPENED
}
