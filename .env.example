DATABASE_URL="postgresql://agecensus:agecensus@localhost:5433/agecensus"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
EMAIL_FROM="Age Census <noreply@localhost>"
# AES-256-GCM key for letter body + census answers (32 bytes, base64).
# Generate: openssl rand -base64 32
# Required in production. Locally falls back to a derivation of AUTH_SECRET if unset.
CONTENT_ENCRYPTION_KEY=""
# Optional. When set, transactional mail (unlock emails) goes through Resend.
# Without it, messages are printed in the server console.
AUTH_RESEND_KEY=""
# Protects /api/cron/unlock-emails. Required in production; optional locally.
CRON_SECRET=""
# Stripe Checkout (test keys locally). Without STRIPE_SECRET_KEY, packs can be granted in development only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
